# ============================================
# 融光 - 环境变量配置
# ============================================
# .env.example 仅作为配置模板，请勿直接修改。
# 请复制该文件并命名为 .env，所有部署配置均在 .env 中修改。
# .env 已被 Git 忽略，Docker Compose 会自动读取该文件。
# ============================================

# ---------- 账号、密码与数据库 ----------
# MySQL root 管理密码。公网部署前请!务必!修改。
MYSQL_ROOT_PASSWORD=123456
# Redis 访问密码。公网部署请!务必!修改。
REDIS_PASSWORD=123456
# MySQL 数据库名，通常无需修改。
MYSQL_DATABASE=ai_fusion_video

# ---------- 默认统一入口 ----------
# docker compose up -d 与本地构建模式使用此端口。
# 启动后访问 http://localhost:8080。
APP_PORT=8080

# ---------- 前后端独立部署 ----------
# 以下配置仅在组合使用 docker-compose.separated.yml 时生效。
# 默认统一入口部署不使用 FRONTEND_PORT 和 BACKEND_PORT，PUBLIC_API_URL 必须保持为空。
# 前端和后端在宿主机上暴露的端口。
FRONTEND_PORT=3000
BACKEND_PORT=18080
# 后端公网根地址，不包含 /api，例如 https://api.example.com。
PUBLIC_API_URL=
# 允许访问后端的前端来源。* 表示全局允许；生产环境可改为明确域名，多个来源用英文逗号分隔。
CORS_ALLOWED_ORIGIN_PATTERNS=*

# ---------- 高级配置 ----------
# 应用默认时区。Asia/Shanghai
APP_TIME_ZONE=Asia/Shanghai
# MySQL 会话时区偏移；与默认应用时区保持一致，且不依赖 MySQL 命名时区表。
MYSQL_SESSION_TIME_ZONE=+08:00
# 后端 JVM 参数，通常无需修改。
JAVA_OPTS=-Xms512m -Xmx1024m

# ---------- 可选的 MySQL 应用账号（非root） ----------
# 如果要配置的话，两个值必须同时配置，账号不能设置为 root。
# 默认留空时沿用 root 与 MYSQL_ROOT_PASSWORD，与历史版本行为一致。
# 如需启用普通账号，请在空数据卷首次启动前填写。
MYSQL_USERNAME=
MYSQL_PASSWORD=
