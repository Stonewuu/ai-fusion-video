# ============================================
# 融光 - 环境变量配置
# ============================================
# 复制此文件为 .env 并修改配置:
#   cp .env.example .env
# ============================================

# ---------- 对外端口 ----------
APP_PORT=8080

# ---------- 部署模式 ----------
# 一体化/统一网关部署保持为空，浏览器使用同源 /api。
PUBLIC_API_URL=
# 仅前后端分域、浏览器直连后端时填写前端公网来源；多个来源用英文逗号分隔。
CORS_ALLOWED_ORIGIN_PATTERNS=
# docker-compose.separated.yml 暴露的端口。
FRONTEND_PORT=3000
BACKEND_PORT=18080

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=ai_fusion_video

# ---------- Redis ----------
REDIS_PASSWORD=123456

# ---------- 后端 JVM ----------
JAVA_OPTS=-Xms512m -Xmx1024m
