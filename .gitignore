# Workspace runtime data
/data/
/logs/
*.log
*.pid
*.pid.lock
hs_err_pid*
replay_pid*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/.pnpm-store/

# Local Docker Compose configuration (copy from .env.example)
/.env

# IDE and editor artifacts
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Patch / merge leftovers
*.orig
*.rej

# Root .vscode is intentionally not ignored here.
# Subproject-level .vscode rules remain in their own .gitignore files.
ai-fusion-video/data/
.codegraph/
.worktrees/
.superpowers/
.gemini/

# Local verification artifacts are kept in the workspace but never committed.
/.local/

# Development docs contain prose only.
/dev-docs/**/*
!/dev-docs/**/
!/dev-docs/**/*.md
!/dev-docs/**/.gitkeep
/dev-docs/**/evidence/
/dev-docs/**/screenshots/
/dev-docs/**/test-results/

