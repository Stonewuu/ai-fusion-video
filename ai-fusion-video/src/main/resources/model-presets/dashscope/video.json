          "maxAspect": 8,
          "mimeTypes": [
            "video/mp4",
            "video/quicktime"
          ]
        },
        "referenceAudioLimits": {
          "minSeconds": 1,
          "maxSeconds": 15,
          "maxTotalSeconds": 15,
          "maxBytes": 15728640
        },
        "supportPromptExtend": true,
        "imageLimits": {
          "maxBytes": 20971520,
          "minDimension": 240,
          "maxDimension": 8000,
          "minAspect": 0.125,
          "maxAspect": 8,
          "mimeTypes": [
            "image/jpeg",
