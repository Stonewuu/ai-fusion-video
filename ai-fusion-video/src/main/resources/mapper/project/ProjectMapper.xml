<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stonewu.fusion.mapper.project.ProjectMapper">
    <select id="lock" resultType="Long">
        SELECT id FROM afv_project WHERE id = #{id} FOR UPDATE
    </select>
    <select id="lockActive" resultType="Long">
        SELECT id FROM afv_project WHERE id = #{id} AND deleted = FALSE FOR UPDATE
    </select>
</mapper>
