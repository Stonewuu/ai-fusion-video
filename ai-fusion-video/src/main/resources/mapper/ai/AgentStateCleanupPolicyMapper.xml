<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stonewu.fusion.mapper.ai.AgentStateCleanupPolicyMapper">
    <select id="selectCurrentForUpdate" resultType="com.stonewu.fusion.entity.ai.AgentStateCleanupPolicy">
        SELECT *
        FROM afv_agent_state_cleanup_policy
        WHERE id = 1
        FOR UPDATE
    </select>
    <select id="selectDatabaseNow" resultType="java.time.LocalDateTime">
        SELECT UTC_TIMESTAMP(3)
    </select>
</mapper>
