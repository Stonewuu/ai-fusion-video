<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stonewu.fusion.mapper.system.RoleMapper">
    <select id="lockByCode" resultType="Long">
        SELECT id FROM sys_role WHERE code = #{code} AND deleted = FALSE FOR UPDATE
    </select>
</mapper>
