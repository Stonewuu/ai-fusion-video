<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stonewu.fusion.mapper.generation.VideoTaskMapper">
    <select id="lock" resultType="Long">
        SELECT id FROM afv_video_task WHERE id = #{id} FOR UPDATE
    </select>
    <select id="selectForUpdate" resultType="com.stonewu.fusion.entity.generation.VideoTask">
        SELECT * FROM afv_video_task WHERE id = #{id} AND deleted = FALSE FOR UPDATE
    </select>
</mapper>
